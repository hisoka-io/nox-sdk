{
  "name": "nox-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "Nox mixnet TypeScript + WASM client SDK",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "wasm:build": "pnpm --filter @hisoka-io/nox-wasm build",
    "wasm:build:bundler": "pnpm --filter @hisoka-io/nox-wasm build:bundler"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "8.3.5",
      "ws@>=8.0.0 <8.21.0": "8.22.0"
    }
  }
}
