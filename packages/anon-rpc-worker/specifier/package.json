{
  "name": "@hisoka-io/anon-rpc-specifier",
  "version": "0.0.0",
  "private": true,
  "description": "On-chain worker specifier contracts (anon-rpc SPEC §4) for the Nox anon-rpc worker, with harness-path tests and read-only deployment planning",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "compile": "forge build",
    "lint": "tsc --noEmit && forge fmt --check && forge lint",
    "test": "tsc --noEmit && forge test && vitest run",
    "test:sol": "forge test",
    "test:ts": "vitest run",
    "plan": "vite-node scripts/plan-deploy.ts --",
    "inspect": "vite-node scripts/inspect-specifier.ts --"
  },
  "devDependencies": {
    "@anon-rpc/browser-harness": "0.3.2",
    "@kpstreams/core": "0.2.1",
    "@types/node": "^20.0.0",
    "ethers": "6.16.0",
    "typescript": "^5.4.0",
    "vite-node": "^1.6.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
