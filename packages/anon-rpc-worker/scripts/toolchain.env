# Pinned toolchain of the canonical worker build (scripts/verify-reproducible.sh).
#
# Every value below feeds the bytes of dist/anon-rpc-worker.js, directly or
# through the embedded nox-wasm module, so every change here is a new worker
# hash. Bump deliberately and record the new hash.
#
# This file is sourced by bash and parsed by scripts/provenance.mjs: plain
# KEY=VALUE lines only, no quotes, no expansions. pnpm is pinned by the root
# package.json "packageManager" field and installed through corepack.

# JavaScript stage: Node 22 LTS on Debian bookworm (multi-arch index digest,
# checked against Docker Hub on 2026-10-04).
NODE_IMAGE=docker.io/library/node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
NODE_VERSION=22.23.3

# WASM stage: rustc 1.95.0 (59807616e 2026-04-14) on Debian bookworm (multi-arch
# index digest, checked against Docker Hub on 2026-10-04).
RUST_IMAGE=docker.io/library/rust:1.95.0-slim-bookworm@sha256:d7482085ff5b415f84dba5647ae71606650bdef00db7aeb69f4b3d170c3e4082
RUST_TOOLCHAIN=1.95.0

# wasm-pack release binaries (github.com/rustwasm/wasm-pack, tag v0.13.1,
# *-unknown-linux-musl archives). No upstream checksum file exists; these
# digests were recorded on 2026-10-03 and re-downloaded and matched on 2026-10-04.
WASM_PACK_VERSION=0.13.1
WASM_PACK_SHA256_X86_64=c539d91ccab2591a7e975bcf82c82e1911b03335c80aa83d67ad25ed2ad06539
WASM_PACK_SHA256_AARCH64=2e65038769f8bbaa5fc237ad4bb523e692df99458cbd3e3d92525b89d8762379

# wasm-bindgen CLI (github.com/wasm-bindgen/wasm-bindgen, *-unknown-linux-musl
# archives): must equal the wasm-bindgen crate version in Cargo.lock. Digests
# match the .sha256sum files published with the release.
WASM_BINDGEN_VERSION=0.2.114
WASM_BINDGEN_SHA256_X86_64=ce21be002bdbc22ede2a5cf250cb801d2106956fc3c529c75d9452729db3490c
WASM_BINDGEN_SHA256_AARCH64=39103878ad3c0016f2d04b7b4a6206c974240286852abac5736d017a43703958

# binaryen (wasm-opt, *-linux archives), on PATH so wasm-pack never downloads
# an optimizer of its own choosing. Digests match the .sha256 files published
# with the release.
BINARYEN_VERSION=117
BINARYEN_SHA256_X86_64=3dc677006555b355ea2da5e82602065a161d5e83eaefd3f759afa00b96e83212
BINARYEN_SHA256_AARCH64=ad560204426015a815faa45693c83bef7d58677d38a39422c272a30ba4b6da2a
